#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# The C code that crate build scripts compile (ring, zstd-sys and others) takes
# its flags from the environment.
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/buildopts.mk
include /usr/share/dpkg/pkg-info.mk

# Ubuntu 24.04 has rustc 1.75; its versioned rustc-1.91 and cargo-1.91 packages
# install the tools here.
ifneq (,$(wildcard /usr/lib/rust-1.91/bin))
export PATH := /usr/lib/rust-1.91/bin:$(PATH)
endif

# Cargo builds offline from vendor/ and keeps away from ~/.cargo.
export CARGO_HOME = $(CURDIR)/debian/cargo-home
# Both paths must be absolute: the sherpa-onnx-sys build script reads them as they are.
export CARGO_TARGET_DIR = $(CURDIR)/target
export SHERPA_ONNX_LIB_DIR = $(CURDIR)/debian/sherpa-lib
# Line tables and no stripping by cargo, so that dh_strip makes the -dbgsym packages.
export CARGO_PROFILE_RELEASE_DEBUG = line-tables-only
export CARGO_PROFILE_RELEASE_STRIP = none
export CARGO_BUILD_JOBS = $(or $(DEB_BUILD_OPTION_PARALLEL),1)
export RUSTFLAGS = --remap-path-prefix=$(CURDIR)=/usr/src/koeinput-$(DEB_VERSION_UPSTREAM)
CARGO_FLAGS = --release --frozen --offline --workspace

%:
	dh $@ --buildsystem=cmake --sourcedirectory=addon

debian/cargo-home/config.toml:
	mkdir -p $(@D)
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "%s"\n[net]\noffline = true\n' "$(CURDIR)/vendor" >$@

# sherpaonnx/ is the no-TTS archive. The sherpa-onnx-sys build script still links
# espeak-ng, piper_phonemize and ucd (the GPL text-to-speech code), so they get
# empty archives here, as in scripts/sherpa-onnx.
debian/sherpa-lib/stamp:
	mkdir -p $(@D)
	ln -sf $(CURDIR)/sherpaonnx/lib/*.a $(@D)/
	set -e; for n in espeak-ng piper_phonemize ucd; do \
	  if [ -e sherpaonnx/lib/lib$$n.a ]; then \
	    echo "sherpaonnx/lib/lib$$n.a exists: not the no-TTS archive" >&2; exit 1; \
	  fi; \
	  ar rcs $(@D)/lib$$n.a; \
	done
	touch $@

# The workspace needs Rust 1.89 (rust-version in Cargo.toml). Stop before the long
# build, with a message that names the fix.
# debhelper passes its default CMake variables, many of which the addon does not
# use (CMAKE_INSTALL_LIBDIR, FETCHCONTENT_FULLY_DISCONNECTED and others); without
# --no-warn-unused-cli, CMake warns about each of them.
override_dh_auto_configure: debian/cargo-home/config.toml debian/sherpa-lib/stamp
	@v=$$(rustc --version 2>/dev/null | cut -d' ' -f2); \
	echo "rustc $${v:-not found} ($$(command -v rustc))"; \
	dpkg --compare-versions "$${v:-0}" ge 1.89 || { \
	  echo "debian/rules: KoeInput needs Rust 1.89 or newer, but rustc is $${v:-not found}." >&2; \
	  echo "debian/rules: on Ubuntu 24.04, install rustc-1.91 and cargo-1.91." >&2; \
	  exit 1; }
	dh_auto_configure -- --no-warn-unused-cli

override_dh_auto_build:
	dh_auto_build
	cargo build $(CARGO_FLAGS) --bins
	scripts/check-no-gpl target/release/koeinput target/release/koeinput-daemon
	target/release/koeinput manpage >debian/koeinput.1

# The addon's D-Bus and fcitx5 tests and the daemon's D-Bus tests need a session
# bus and a test daemon; they run in the development test runs only.
# cargo test builds with other features (dev-dependencies) and would relink the
# binaries in target/release, after check-no-gpl and before they are installed,
# so it gets its own target directory.
override_dh_auto_test:
	dh_auto_test -- 'ARGS+=-R controller'
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	CARGO_TARGET_DIR=$(CURDIR)/target-test cargo test $(CARGO_FLAGS)
endif

override_dh_auto_install:
	dh_auto_install
	install -D -m 0755 target/release/koeinput debian/tmp/usr/bin/koeinput
	install -D -m 0755 target/release/koeinput-daemon debian/tmp/usr/libexec/koeinput/koeinput-daemon
	install -D -m 0644 data/koeinput.service debian/tmp/usr/lib/systemd/user/koeinput.service
	install -D -m 0644 data/org.nemui.KoeInput.service debian/tmp/usr/share/dbus-1/services/org.nemui.KoeInput.service
	install -D -m 0644 data/models.toml debian/tmp/usr/share/koeinput/models.toml

# Checks the files that ship, which dh_strip is about to strip.
execute_before_dh_strip:
	scripts/check-no-gpl debian/koeinput/usr/bin/koeinput debian/koeinput/usr/libexec/koeinput/koeinput-daemon

override_dh_auto_clean:
	dh_auto_clean
	rm -rf target target-test debian/cargo-home debian/sherpa-lib debian/koeinput.1

# dh_clean deletes *.orig files, which would take the vendored Cargo.toml.orig
# files with it and break cargo's checksums of the vendored crates.
override_dh_clean:
	dh_clean -XCargo.toml.orig
