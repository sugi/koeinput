#!/bin/sh
# Installs the packages from target/deb/<dist>/ in a fresh container of the
# distribution (debian:<dist>, ubuntu:24.04 for noble, ubuntu:26.04 for resolute)
# and runs the install test of scripts/lib/install-checks.sh: the installed files,
# the koeinput command and man page, D-Bus activation of the daemon, loading the
# addon in a headless fcitx5, then removal and a second install. apt needs the
# network for the dependencies. The output also goes to target/deb/<dist>/test.log.
# sid has no build of its own: "sid" tests the forky packages in debian:sid and
# saves the output in target/deb/forky/test-sid.log.
# Usage: scripts/test-deb trixie|forky|sid|noble|resolute
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

die() {
  echo "scripts/test-deb: $*" >&2
  exit 1
}
case "${1:-}" in
  trixie) dist=$1 image=docker.io/library/debian:$1 suffix="~${1}1" log=test.log ;;
  forky) dist=$1 image=docker.io/library/debian:$1 suffix='' log=test.log ;;
  sid) dist=forky image=docker.io/library/debian:sid suffix='' log=test-sid.log ;;
  noble) dist=$1 image=docker.io/library/ubuntu:24.04 suffix="~${1}1" log=test.log ;;
  resolute) dist=$1 image=docker.io/library/ubuntu:26.04 suffix="~${1}1" log=test.log ;;
  *)
    echo "usage: scripts/test-deb trixie|forky|sid|noble|resolute" >&2
    exit 2 ;;
esac

version=$(sed -n '1s/^[^ ]* (\([^)]*\)).*/\1/p' debian/changelog)
[ -n "$version" ] || die "cannot read the version from debian/changelog"
version=${version#*:}
upstream=${version%-*}
# scripts/build-deb adds this local version to the trixie and Ubuntu builds.
version=$version$suffix
out=target/deb/$dist
for pkg in koeinput fcitx5-koeinput; do
  [ -e "$out/${pkg}_${version}_amd64.deb" ] ||
    die "$out/${pkg}_${version}_amd64.deb is missing; run scripts/build-deb $dist first"
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM

# What differs from the other formats; scripts/lib/install-checks.sh lists the names.
cat >"$tmp/format.sh" <<'EOF'
export DEBIAN_FRONTEND=noninteractive
PKGS="/pkgs/koeinput_${VERSION}_amd64.deb /pkgs/fcitx5-koeinput_${VERSION}_amd64.deb"
DAEMON=/usr/libexec/koeinput/koeinput-daemon
ADDON_DIR=/usr/lib/x86_64-linux-gnu/fcitx5
COPYRIGHT=/usr/share/doc/koeinput/copyright
# dh_compress compresses the files in /usr/share/doc that are larger than 4 kB.
NOTICES=/usr/share/doc/koeinput/onnxruntime-*-ThirdPartyNotices.txt.gz
KOEINPUT_DOC_FILES="/usr/share/doc/koeinput/README.md.gz /usr/share/doc/koeinput/README.ja.md.gz /usr/share/doc/koeinput/models.md"
ADDON_DOC_FILES=/usr/share/doc/fcitx5-koeinput/copyright
REMOVED="/usr/share/doc/koeinput /usr/share/doc/fcitx5-koeinput"
REMOVE_LABEL="apt-get remove"

prepare_image() {
  # The Ubuntu container images leave out man pages, translations and most of
  # /usr/share/doc, and divert man to a stub. A normal Ubuntu install has them.
  if [ -e /etc/dpkg/dpkg.cfg.d/excludes ]; then
    rm /etc/dpkg/dpkg.cfg.d/excludes
    if [ "$(dpkg-divert --truename /usr/bin/man)" = /usr/bin/man.REAL ]; then
      rm -f /usr/bin/man
      dpkg-divert --quiet --remove --rename /usr/bin/man
    fi
  fi
}
first_install() {
  apt-get update -q
  install_packages
}
install_packages() { apt-get install -y -q --no-install-recommends $PKGS; }
install_tools() { apt-get install -y -q --no-install-recommends man-db dbus-bin; }
show_versions() { dpkg-query -W koeinput fcitx5-koeinput fcitx5 dbus-daemon; }
owner() { dpkg -S "$1" | cut -d: -f1; }
list_files() { dpkg -L koeinput fcitx5-koeinput; }
remove_packages() { apt-get remove -y -q koeinput fcitx5-koeinput; }
is_installed() { [ "$(dpkg-query -W -f '${db:Status-Abbrev}' "$1" 2>/dev/null)" = "ii " ]; }
EOF

# podman run --init would need catatonit on the host, so the test runs its own PID 1.
{
  nice -n 10 podman run --rm \
    -v "$root/$out:/pkgs:ro" -v "$root/scripts/lib/install-checks.sh:/test/checks.sh:ro" \
    -v "$tmp/format.sh:/test/format.sh:ro" \
    -e VERSION="$version" -e UPSTREAM="$upstream" \
    "$image" sh /test/checks.sh pid1 || echo $? >"$tmp/failed"
} 2>&1 | tee "$out/$log"
if [ -e "$tmp/failed" ]; then
  die "the install test failed for $1; see $out/$log"
fi
