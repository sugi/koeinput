#!/usr/bin/env python3
"""Writes debian/copyright (DEP-5) for the Debian source package.

Usage: scripts/gen-copyright [--check]

One paragraph per vendored crate comes from `cargo metadata` (authors and the
license expression), one paragraph covers the sherpa-onnx archive (the table
below), and the license texts come from packaging/licenses/ or from a crate's
own license file. Texts in /usr/share/common-licenses/ are referenced.

--check compares the result with the committed debian/copyright and exits 1
with a diff when they differ.

cargo has to run in the build container, so outside a container this script
runs itself again through scripts/dev.
"""

import difflib
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLATFORM = "x86_64-unknown-linux-gnu"

HEADER = """\
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: koeinput
Upstream-Contact: Tatsuki Sugiura <sugi@nemui.org>
Source: https://github.com/sugi/koeinput
Comment: Generated by scripts/gen-copyright; do not edit by hand.

Files: *
Copyright: 2026 Tatsuki Sugiura
License: MIT or Apache-2.0
"""

# The sherpa-onnx component: the pinned no-TTS archive in packaging/sherpa-onnx.env.
# Versions are the ones sherpa-onnx v1.13.8 pins in its cmake/*.cmake files;
# packaging/licenses/README lists the commits. Update both with the pin.
SHERPA_COPYRIGHT = [
    "Xiaomi Corporation and other contributors (sherpa-onnx, kaldi-native-fbank, kaldi-decoder, kaldifst)",
    "the Kaldi authors (code taken into kaldi-native-fbank, kaldi-decoder and kaldifst)",
    "Microsoft Corporation (ONNX Runtime)",
    "the authors of the third-party code in ONNX Runtime, listed in its ThirdPartyNotices",
    "2005-2026 Google LLC (OpenFst)",
    "2024 Wei Kang and other contributors (simple-sentencepiece)",
    "2003-2010 Mark Borgerding (kissfft)",
    "2011 Daniel Müllner, 2018 Christoph Dalitz (hclust-cpp)",
    "2013-2025 Niels Lohmann (nlohmann/json)",
    "the Eigen authors",
]
SHERPA_LICENSE = "Apache-2.0 and MIT and BSD-2-Clause and BSD-3-Clause and BSL-1.0 and MPL-2.0"
SHERPA_COMMENT = """\
Static libraries from the sherpa-onnx v1.13.8 release, archive
sherpa-onnx-v1.13.8-linux-x64-static-no-tts-lib.tar.bz2. It is built without
text to speech, so it contains no espeak-ng, ucd-tools or piper-phonemize.
The archive holds no source code and no license files. The license texts were
taken from each upstream repository at the version sherpa-onnx v1.13.8 pins:

sherpa-onnx 1.13.8 (k2-fsa/sherpa-onnx): Apache-2.0
ONNX Runtime 1.28.2 (microsoft/onnxruntime): MIT. The third-party code it
  bundles (protobuf, abseil, re2, flatbuffers, onnx, Microsoft GSL, date,
  SafeInt, cpuinfo, Eigen, Boost mp11, FP16 and others) is listed with its
  licenses in /usr/share/doc/koeinput/onnxruntime-1.28.2-ThirdPartyNotices.txt.gz
kaldi-native-fbank 1.22.3 (csukuangfj/kaldi-native-fbank): Apache-2.0
kissfft, commit febd4caeed32e33ad8b2e0bb5ea77542c40f18ec (mborgerding/kissfft): BSD-3-Clause
kaldi-decoder 0.3.0 (k2-fsa/kaldi-decoder): Apache-2.0
kaldifst 1.8.0 (k2-fsa/kaldifst, pinned by kaldi-decoder): Apache-2.0
OpenFst 1.8.5-2026-07-09 (csukuangfj/openfst): Apache-2.0
simple-sentencepiece 0.7 (pkufool/simple-sentencepiece): Apache-2.0
hclust-cpp 2026-02-25, fastcluster (csukuangfj/hclust-cpp): BSD-2-Clause
nlohmann/json 3.12.0: MIT
Eigen 5.0.1, header-only: MPL-2.0, with some files under BSD and other
  MPL-2.0-compatible licenses. Source code:
  https://gitlab.com/libeigen/eigen/-/archive/5.0.1/eigen-5.0.1.tar.gz
"""

STUB_COMMENT = [
    "Stub made by cargo-vendor-filterer: the crate's Cargo.toml and an empty",
    f"src/lib.rs. The crate is not built for {PLATFORM}.",
]

# Licenses whose text Debian ships: SPDX id -> (file name, name in the pointer sentence).
COMMON_LICENSES = {
    "Apache-2.0": ("Apache-2.0", "the Apache License, Version 2.0"),
    "BSL-1.0": ("BSL-1.0", "the Boost Software License, Version 1.0"),
    "CC0-1.0": ("CC0-1.0", "the Creative Commons CC0 1.0 Universal license"),
    "LGPL-2.1-or-later": ("LGPL-2.1", "the GNU Lesser General Public License, version 2.1"),
    "MPL-2.0": ("MPL-2.0", "the Mozilla Public License, Version 2.0"),
}


@dataclass
class Text:
    """A license text: a file in the repository or in a crate, optionally cut to the
    lines from `start` up to (not including) `stop`, to drop copyright lines and
    remarks that belong to that one project."""

    file: str
    crate: str = ""
    start: str = ""
    stop: str = ""


LICENSE_TEXTS = {
    "0BSD": Text("LICENSE-0BSD", crate="adler2", start=r"Permission to use"),
    "BSD-2-Clause": Text("packaging/licenses/hclust-LICENSE", start=r"Redistribution and use"),
    "BSD-3-Clause": Text("packaging/licenses/kissfft-BSD-3-Clause", start=r"Redistribution and use"),
    "bzip2-1.0.6": Text("LICENSE", crate="libbz2-rs-sys", start=r"Redistribution and use",
                        stop=r"Julian Seward, jseward"),
    "CDLA-Permissive-2.0": Text("LICENSE", crate="webpki-roots"),
    "ISC": Text("LICENSE", crate="rustls-webpki", start=r"Permission to use",
                stop=r"The files under third-party"),
    "MIT": Text("LICENSE-MIT", crate="anyhow"),
    "MIT-0": Text("LICENSE-MIT0", crate="constant_time_eq"),
    "Unicode-3.0": Text("LICENSE-UNICODE", crate="unicode-ident"),
    "Unlicense": Text("UNLICENSE", crate="memchr"),
    "Zlib": Text("LICENSE", crate="zlib-rs", start=r"This software is provided"),
}

EXCEPTION_TEXTS = {
    "LLVM-exception": Text("LICENSE-Apache-2.0_WITH_LLVM-exception", crate="rustix",
                           start=r"--- LLVM Exceptions"),
}


class Error(Exception):
    pass


def cargo_metadata(*extra):
    out = subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--locked", *extra],
        cwd=ROOT, check=True, stdout=subprocess.PIPE,
    ).stdout
    return json.loads(out)


# SPDX license expressions --------------------------------------------------------

def tokenize(expr):
    # Old crates write "MIT/Apache-2.0" for "MIT OR Apache-2.0".
    return re.findall(r"\(|\)|[^\s()/]+|/", expr)


def parse(expr):
    """Parses an SPDX expression into nested tuples ("or"|"and", [children]),
    ("with", license, exception) and license id strings."""
    tokens = tokenize(expr)
    pos = 0

    def peek():
        return tokens[pos] if pos < len(tokens) else None

    def take():
        nonlocal pos
        tok = peek()
        pos += 1
        return tok

    def atom():
        tok = take()
        if tok == "(":
            node = disjunction()
            if take() != ")":
                raise Error(f"unbalanced parentheses in {expr!r}")
            return node
        if tok in (None, ")", "/") or tok.upper() in ("AND", "OR", "WITH"):
            raise Error(f"cannot parse license expression {expr!r}")
        if peek() and peek().upper() == "WITH":
            take()
            exception = take()
            if exception in (None, "(", ")", "/"):
                raise Error(f"cannot parse license expression {expr!r}")
            return ("with", tok, exception)
        return tok

    def conjunction():
        nodes = [atom()]
        while peek() and peek().upper() == "AND":
            take()
            nodes.append(atom())
        return nodes[0] if len(nodes) == 1 else ("and", nodes)

    def disjunction():
        nodes = [conjunction()]
        while peek() and (peek().upper() == "OR" or peek() == "/"):
            take()
            nodes.append(conjunction())
        return nodes[0] if len(nodes) == 1 else ("or", nodes)

    node = disjunction()
    if peek() is not None:
        raise Error(f"cannot parse license expression {expr!r}")
    return node


def exception_name(license_id, exception):
    keyword = exception[: -len("-exception")] if exception.endswith("-exception") else exception
    return f"{license_id} with {keyword} exception"


def to_dep5(node):
    """Renders a parsed expression in DEP-5 syntax. DEP-5 has no parentheses:
    "and" binds tighter than "or", and ", and" closes an "or" list."""
    if isinstance(node, str):
        return node
    if node[0] == "with":
        return exception_name(node[1], node[2])
    kind, children = node
    if kind == "or":
        for child in children:
            if isinstance(child, tuple) and child[0] == "and" and any(
                isinstance(c, tuple) and c[0] == "or" for c in child[1]
            ):
                raise Error("an OR inside an AND inside an OR has no DEP-5 form")
        return " or ".join(to_dep5(c) for c in children)
    ors = [c for c in children if isinstance(c, tuple) and c[0] == "or"]
    rest = [c for c in children if not (isinstance(c, tuple) and c[0] == "or")]
    if len(ors) > 1:
        raise Error("two OR lists inside an AND have no DEP-5 form")
    tail = " and ".join(to_dep5(c) for c in rest)
    return f"{to_dep5(ors[0])}, and {tail}" if ors else tail


def license_names(node, out):
    """Collects the standalone license names (DEP-5 form) an expression needs,
    as name -> (license id, exception id or None)."""
    if isinstance(node, str):
        out[node] = (node, None)
    elif node[0] == "with":
        out[exception_name(node[1], node[2])] = (node[1], node[2])
    else:
        for child in node[1]:
            license_names(child, out)
    return out


# Text formatting -----------------------------------------------------------------

def field(name, lines):
    """A DEP-5 field whose first line follows the name and whose other lines are
    continuation lines; empty lines become " ."."""
    out = [f"{name}: {lines[0]}" if lines[0] else f"{name}:"]
    for line in lines[1:]:
        out.append(f" {line}" if line.strip() else " .")
    return "\n".join(out)


def clean_lines(text):
    lines = [line.rstrip().expandtabs() for line in text.lstrip("﻿").splitlines()]
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    return lines


def read_text(spec, crates):
    if spec.crate:
        if spec.crate not in crates:
            raise Error(
                f"the license text source crate {spec.crate} is no longer vendored; "
                "pick another source in LICENSE_TEXTS or EXCEPTION_TEXTS"
            )
        path = crates[spec.crate] / spec.file
    else:
        path = ROOT / spec.file
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    if spec.start:
        index = next((i for i, l in enumerate(lines) if re.match(spec.start, l.lstrip())), None)
        if index is None:
            raise Error(f"{path}: no line starts with {spec.start!r}")
        lines = lines[index:]
    if spec.stop:
        index = next((i for i, l in enumerate(lines) if re.match(spec.stop, l.lstrip())), None)
        if index is None:
            raise Error(f"{path}: no line starts with {spec.stop!r}")
        lines = lines[:index]
    return clean_lines("\n".join(lines))


def common_pointer(license_id):
    file, title = COMMON_LICENSES[license_id]
    return [
        f"On Debian systems, the full text of {title}",
        f"can be found in /usr/share/common-licenses/{file}.",
    ]


def license_paragraph(name, license_id, exception, crates):
    if license_id in COMMON_LICENSES:
        body = common_pointer(license_id)
    elif license_id in LICENSE_TEXTS:
        body = read_text(LICENSE_TEXTS[license_id], crates)
    else:
        raise Error(f"no text for license {license_id}; add it to LICENSE_TEXTS or COMMON_LICENSES")
    if exception:
        if exception not in EXCEPTION_TEXTS:
            raise Error(f"no text for license exception {exception}; add it to EXCEPTION_TEXTS")
        body = body + [""] + read_text(EXCEPTION_TEXTS[exception], crates)
    return field("License", [name] + body)


# The file ------------------------------------------------------------------------

def generate():
    full = cargo_metadata()
    built = cargo_metadata("--filter-platform", PLATFORM)
    members = set(full["workspace_members"])
    built_ids = {p["id"] for p in built["packages"]}
    packages = sorted(
        (p for p in full["packages"] if p["id"] not in members),
        key=lambda p: (p["name"], p["version"]),
    )

    # One version of each crate, for the license texts taken from crates.
    crates = {}
    for p in packages:
        crates[p["name"]] = Path(p["manifest_path"]).parent

    needed = {}
    paragraphs = [HEADER.rstrip("\n")]
    license_names(parse("MIT OR Apache-2.0"), needed)
    for p in packages:
        if not p["license"]:
            raise Error(f"{p['name']} {p['version']} declares no SPDX license (license-file only)")
        node = parse(p["license"])
        license_names(node, needed)
        authors = [a.strip() for a in p["authors"] if a.strip()] or [f"{p['name']} contributors"]
        lines = [
            f"Files: vendor/{p['name']}-{p['version']}/*",
            field("Copyright", authors),
            f"License: {to_dep5(node)}",
        ]
        if p["id"] not in built_ids:
            lines.append(field("Comment", STUB_COMMENT))
        paragraphs.append("\n".join(lines))

    license_names(parse(SHERPA_LICENSE.replace(" and ", " AND ")), needed)
    paragraphs.append("\n".join([
        "Files: sherpaonnx/*",
        field("Copyright", SHERPA_COPYRIGHT),
        f"License: {SHERPA_LICENSE}",
        field("Comment", SHERPA_COMMENT.splitlines()),
    ]))

    for name in sorted(needed, key=str.lower):
        license_id, exception = needed[name]
        paragraphs.append(license_paragraph(name, license_id, exception, crates))
    return "\n\n".join(paragraphs) + "\n"


def in_container():
    return Path("/run/.containerenv").exists()


def main(argv):
    if argv not in ([], ["--check"]):
        print("usage: scripts/gen-copyright [--check]", file=sys.stderr)
        return 2
    if not in_container():
        os.execv(ROOT / "scripts" / "dev",
                 [str(ROOT / "scripts" / "dev"), "python3", "scripts/gen-copyright", *argv])
    target = ROOT / "debian" / "copyright"
    try:
        text = generate()
    except (Error, OSError, subprocess.CalledProcessError) as err:
        print(f"scripts/gen-copyright: {err}", file=sys.stderr)
        return 2
    if argv == ["--check"]:
        current = target.read_text(encoding="utf-8") if target.exists() else ""
        if current == text:
            print("debian/copyright is up to date")
            return 0
        sys.stdout.writelines(difflib.unified_diff(
            current.splitlines(keepends=True), text.splitlines(keepends=True),
            "debian/copyright", "generated",
        ))
        print("debian/copyright is out of date; run scripts/gen-copyright", file=sys.stderr)
        return 1
    target.write_text(text, encoding="utf-8")
    print(f"wrote {target.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
