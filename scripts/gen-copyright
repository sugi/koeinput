@dataclass
class Text:
    """A license text: a file in the repository or in a crate, optionally cut to the
    lines from `start` up to (not including) `stop`, to drop copyright lines and
    remarks that belong to that one project. `prefix` is a comment marker to
    remove from every line first."""

    file: str
    crate: str = ""
    start: str = ""
    stop: str = ""
    prefix: str = ""


LICENSE_TEXTS = {
    "0BSD": Text("LICENSE-0BSD", crate="adler2", start=r"Permission to use"),
    "BSD-2-Clause": Text("packaging/licenses/hclust-LICENSE", start=r"Redistribution and use"),
    "BSD-3-Clause": Text("packaging/licenses/kissfft-BSD-3-Clause", start=r"Redistribution and use"),
    "bzip2-1.0.6": Text("LICENSE", crate="libbz2-rs-sys", start=r"Redistribution and use",
                        stop=r"Julian Seward, jseward@"),
    "CC-BY-3.0": Text("LICENSE-THIRD-PARTY", crate="crossbeam-channel",
                      start=r"Creative Commons Legal Code", stop=r"={20}"),
    "CDLA-Permissive-2.0": Text("LICENSE", crate="webpki-roots"),
    "FSFAP": Text("xz-5.2/m4/ax_check_capsicum.m4", crate="lzma-sys", prefix=r"#\s*",
                  start=r"Copying and distribution", stop=r"$"),
    "FSFULLR": Text("xz-5.2/m4/getopt.m4", crate="lzma-sys", prefix=r"dnl\s?",
                    start=r"This file is free software", stop=r"$"),
    "ISC": Text("LICENSE", crate="rustls-webpki", start=r"Permission to use",
                stop=r"The files under third-party"),
    "MIT": Text("LICENSE-MIT", crate="anyhow"),
    "MIT-0": Text("LICENSE-MIT0", crate="constant_time_eq"),
    "public-domain": Text("xz-5.2/COPYING", crate="lzma-sys", start=r"You can do whatever you want",
                          stop=r"As usual, this software"),
    "Unicode-3.0": Text("LICENSE-UNICODE", crate="unicode-ident"),
    "Unlicense": Text("UNLICENSE", crate="memchr"),
    "Zlib": Text("LICENSE", crate="zlib-rs", start=r"This software is provided"),
}

EXCEPTION_TEXTS = {
    "Autoconf-exception-macro": Text("xz-5.2/m4/ax_pthread.m4", crate="lzma-sys", prefix=r"#\s*",
                                     start=r"As a special exception", stop=r"serial \d+"),
    "LLVM-exception": Text("LICENSE-Apache-2.0_WITH_LLVM-exception", crate="rustix",
                           start=r"--- LLVM Exceptions"),
}

# Copyright notices of a crate come from these files (any directory).
NOTICE_FILE = re.compile(r"(?i)^(licen[cs]e|copying|copyright|notice|unlicense)")
PLACEHOLDER = re.compile(r"(?i)[\[{<]\s*(yyyy|year|name|owner|copyright|fullname|author)")
NOT_A_NOTICE = re.compile(
    r"(?i)^copyright\s*(and|notice|license|holders?|owners?|laws?|interest|statement|protection)\b|^copyright\s*$"
)


class Error(Exception):
    pass


def cargo_metadata(*extra):
    out = subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--locked", *extra],
        cwd=ROOT, check=True, stdout=subprocess.PIPE,
    ).stdout
    return json.loads(out)


# SPDX license expressions --------------------------------------------------------

def tokenize(expr):
    # Old crates write "MIT/Apache-2.0" for "MIT OR Apache-2.0".
    return re.findall(r"\(|\)|[^\s()/]+|/", expr)


def parse(expr):
    """Parses an SPDX expression into nested tuples ("or"|"and", [children]),
    ("with", license, exception) and license id strings."""
    tokens = tokenize(expr)
    pos = 0

    def peek():
        return tokens[pos] if pos < len(tokens) else None

    def take():
        nonlocal pos
        tok = peek()
        pos += 1
        return tok

    def atom():
        tok = take()
        if tok == "(":
            node = disjunction()
            if take() != ")":
                raise Error(f"unbalanced parentheses in {expr!r}")
            return node
        if tok in (None, ")", "/") or tok.upper() in ("AND", "OR", "WITH"):
            raise Error(f"cannot parse license expression {expr!r}")
        if peek() and peek().upper() == "WITH":
            take()
            exception = take()
            if exception in (None, "(", ")", "/"):
                raise Error(f"cannot parse license expression {expr!r}")
            return ("with", tok, exception)
        return tok

    def conjunction():
        nodes = [atom()]
        while peek() and peek().upper() == "AND":
            take()
            nodes.append(atom())
        return nodes[0] if len(nodes) == 1 else ("and", nodes)

    def disjunction():
        nodes = [conjunction()]
        while peek() and (peek().upper() == "OR" or peek() == "/"):
            take()
            nodes.append(conjunction())
        return nodes[0] if len(nodes) == 1 else ("or", nodes)

    node = disjunction()
    if peek() is not None:
        raise Error(f"cannot parse license expression {expr!r}")
    return node


def exception_name(license_id, exception):
    keyword = exception[: -len("-exception")] if exception.endswith("-exception") else exception
    return f"{license_id} with {keyword} exception"


def to_dep5(node):
    """Renders a parsed expression in DEP-5 syntax. DEP-5 has no parentheses:
    "and" binds tighter than "or", and ", and" closes an "or" list."""
    if isinstance(node, str):
        return node
    if node[0] == "with":
        return exception_name(node[1], node[2])
    kind, children = node
    if kind == "or":
        for child in children:
            if isinstance(child, tuple) and child[0] == "and" and any(
                isinstance(c, tuple) and c[0] == "or" for c in child[1]
            ):
                raise Error("an OR inside an AND inside an OR has no DEP-5 form")
        return " or ".join(to_dep5(c) for c in children)
    ors = [c for c in children if isinstance(c, tuple) and c[0] == "or"]
    rest = [c for c in children if not (isinstance(c, tuple) and c[0] == "or")]
    if len(ors) > 1:
        raise Error("two OR lists inside an AND have no DEP-5 form")
    tail = " and ".join(to_dep5(c) for c in rest)
    return f"{to_dep5(ors[0])}, and {tail}" if ors else tail


def license_names(node, out):
    """Collects the standalone license names (DEP-5 form) an expression needs,
    as name -> (license id, exception id or None)."""
    if isinstance(node, str):
        out[node] = (node, None)
    elif node[0] == "with":
        out[exception_name(node[1], node[2])] = (node[1], node[2])
    else:
        for child in node[1]:
            license_names(child, out)
    return out



# Text formatting -----------------------------------------------------------------

def field(name, lines):
    """A DEP-5 field whose first line follows the name and whose other lines are
    continuation lines; empty lines become " ."."""
    out = [f"{name}: {lines[0]}" if lines[0] else f"{name}:"]
    for line in lines[1:]:
        out.append(f" {line}" if line.strip() else " .")
    return "\n".join(out)


def clean_lines(lines):
    text = textwrap.dedent("\n".join(l.rstrip().expandtabs() for l in lines))
    lines = text.lstrip("﻿").splitlines()
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    return lines


def crate_dir(crates, name, what):
    if name not in crates:
        raise Error(f"crate {name} is no longer vendored; update {what} in scripts/gen-copyright")
    return crates[name]


def read_text(spec, crates):
    path = crate_dir(crates, spec.crate, "LICENSE_TEXTS or EXCEPTION_TEXTS") / spec.file \
        if spec.crate else ROOT / spec.file
    lines = path.read_text(encoding="utf-8").splitlines()
    if spec.prefix:
        lines = [re.sub("^" + spec.prefix, "", line) for line in lines]

    def find(pattern, lines):
        index = next((i for i, l in enumerate(lines) if re.match(pattern, l.lstrip())), None)
        if index is None:
            raise Error(f"{path}: no line starts with {pattern!r}")
        return index

    if spec.start:
        lines = lines[find(spec.start, lines):]
    if spec.stop:
        lines = lines[:find(spec.stop, lines)]
    return clean_lines(lines)


def common_pointer(license_id):
    file, title = COMMON_LICENSES[license_id]
    return [
        f"On Debian systems, the full text of {title}",
        f"can be found in /usr/share/common-licenses/{file}.",
    ]


def license_paragraph(name, license_id, exception, crates):
    if license_id in COMMON_LICENSES:
        body = common_pointer(license_id)
    elif license_id in LICENSE_TEXTS:
        body = read_text(LICENSE_TEXTS[license_id], crates)
    else:
        raise Error(f"no text for license {license_id}; add it to LICENSE_TEXTS or COMMON_LICENSES")
    if exception:
        if exception not in EXCEPTION_TEXTS:
            raise Error(f"no text for license exception {exception}; add it to EXCEPTION_TEXTS")
        body = body + [""] + read_text(EXCEPTION_TEXTS[exception], crates)
    return field("License", [name] + body)


# Copyright notices -----------------------------------------------------------------

def notices_in(text):
    """The copyright lines of a license file, without the placeholders of license
    templates and the sentences of license texts that mention copyright."""
    found = []
    for raw in text.splitlines():
        line = re.sub(r"\s+", " ", re.sub(r"^[\s#/*;!-]+", "", raw)).strip()
        lower = line.lower()
        notice = None
        if lower.startswith("copyright"):
            notice = None if NOT_A_NOTICE.match(line) else line
        elif lower.startswith("(c)") or line.startswith("©"):
            notice = line if re.match(r"(?i)(\(c\)|©)\s*\d{4}", line) else None
        else:
            match = re.search(r"(?i)\bcopyright\s*(\(c\)|©)?\s*\d{4}", line)
            if match:
                notice = line[match.start():]
            elif re.search(r"©\s*\d{4}", line):
                notice = line
        if notice and not PLACEHOLDER.search(notice) and notice not in found:
            found.append(notice)
    return found


def crate_files(directory):
    for parent, dirs, files in os.walk(directory):
        dirs.sort()
        for name in sorted(files):
            path = Path(parent) / name
            yield path.relative_to(directory).as_posix(), path


def crate_notices(directory, skip):
    """Copyright lines from the license and notice files of a crate, leaving out
    the files that `skip` (DEP-5 patterns of bundled code) covers."""
    found = []
    for relative, path in crate_files(directory):
        if not NOTICE_FILE.match(path.name) or any(fnmatch.fnmatchcase(relative, p) for p in skip):
            continue
        for notice in notices_in(path.read_text(encoding="utf-8", errors="replace")):
            if notice not in found:
                found.append(notice)
    return found


# The file ------------------------------------------------------------------------

def files_paragraph(paragraph, needed, prefix=""):
    node = parse(paragraph.license)
    license_names(node, needed)
    lines = [
        field("Files", [prefix + p for p in paragraph.files]),
        field("Copyright", paragraph.copyright),
        f"License: {to_dep5(node)}",
    ]
    if paragraph.comment:
        lines.append(field("Comment", paragraph.comment))
    return "\n".join(lines)


def check_patterns(paragraphs, files, where):
    for paragraph in paragraphs:
        for pattern in paragraph.files:
            if not any(fnmatch.fnmatchcase(f, pattern) for f in files):
                raise Error(f"{where}: the pattern {pattern} matches no file")


def generate():
    full = cargo_metadata()
    built = cargo_metadata("--filter-platform", PLATFORM)
    members = set(full["workspace_members"])
    built_ids = {p["id"] for p in built["packages"]}
    packages = sorted(
        (p for p in full["packages"] if p["id"] not in members),
        key=lambda p: (p["name"], p["version"]),
    )
    crates = {p["name"]: Path(p["manifest_path"]).parent for p in packages}
    for name in BUNDLED:
        crate_dir(crates, name, "BUNDLED")
    for name in EXTRA_HOLDERS:
        crate_dir(crates, name, "EXTRA_HOLDERS")

    needed = {}
    license_names(parse("MIT OR Apache-2.0"), needed)
    paragraphs = [HEADER.rstrip("\n")]

    licenses = sorted(p.relative_to(ROOT).as_posix() for p in (ROOT / "packaging/licenses").iterdir())
    check_patterns(REPO_LICENSE_FILES, licenses, "REPO_LICENSE_FILES")
    for name in licenses:
        if name != "packaging/licenses/README" and not any(
            fnmatch.fnmatchcase(name, p) for par in REPO_LICENSE_FILES for p in par.files
        ):
            raise Error(f"{name} is in no paragraph of REPO_LICENSE_FILES")
    paragraphs += [files_paragraph(p, needed) for p in REPO_LICENSE_FILES]

    for p in packages:
        if not p["license"]:
            raise Error(f"{p['name']} {p['version']} declares no SPDX license (license-file only)")
        directory = Path(p["manifest_path"]).parent
        bundled = BUNDLED.get(p["name"], [])
        skip = [pattern for b in bundled for pattern in b.files]
        copyright = (crate_notices(directory, skip)
                     or [a.strip() for a in p["authors"] if a.strip()]
                     or [f"{p['name']} contributors"])
        copyright += [h for h in EXTRA_HOLDERS.get(p["name"], []) if h not in copyright]
        stub = p["id"] not in built_ids
        prefix = f"vendor/{p['name']}-{p['version']}/"
        paragraphs.append(files_paragraph(
            Paragraph(["*"], copyright, p["license"], STUB_COMMENT if stub else []), needed, prefix))
        if bundled and not stub:
            check_patterns(bundled, [f for f, _ in crate_files(directory)], f"BUNDLED[{p['name']}]")
            paragraphs += [files_paragraph(b, needed, prefix) for b in bundled]

    paragraphs += [files_paragraph(p, needed) for p in SHERPA]

    for name in sorted(needed, key=str.lower):
        license_id, exception = needed[name]
        paragraphs.append(license_paragraph(name, license_id, exception, crates))
    return "\n\n".join(paragraphs) + "\n"


def main(argv):
    if argv not in ([], ["--check"]):
        print("usage: scripts/gen-copyright [--check]", file=sys.stderr)
        return 2
    if os.environ.get("KOEINPUT_IN_DEV_CONTAINER") != "1":
        os.execv(ROOT / "scripts" / "dev",
                 [str(ROOT / "scripts" / "dev"), "python3", "scripts/gen-copyright", *argv])
    target = ROOT / "debian" / "copyright"
    try:
        text = generate()
    except (Error, OSError, subprocess.CalledProcessError) as err:
        print(f"scripts/gen-copyright: {err}", file=sys.stderr)
        return 2
    if argv == ["--check"]:
        current = target.read_text(encoding="utf-8") if target.exists() else ""
        if current == text:
            print("debian/copyright is up to date")
            return 0
        sys.stdout.writelines(difflib.unified_diff(
            current.splitlines(keepends=True), text.splitlines(keepends=True),
            "debian/copyright", "generated",
        ))
        print("debian/copyright is out of date; run scripts/gen-copyright", file=sys.stderr)
        return 1
    target.write_text(text, encoding="utf-8")
    print(f"wrote {target.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
