#!/usr/bin/env python3
"""Writes debian/copyright (DEP-5) for the Debian source package.

Usage: scripts/gen-copyright [--check]

One paragraph per vendored crate comes from `cargo metadata` (the license
expression) and from the copyright lines in the crate's license files; the
tables below add holders that those files leave out, and paragraphs for files
inside some crates under other licenses, for the sherpa-onnx archive and for
packaging/licenses/. The license texts come from
packaging/licenses/ or from a crate's own license file; texts in
/usr/share/common-licenses/ are referenced.

--check compares the result with the committed debian/copyright and exits 1
with a diff when they differ.

cargo has to run in the build container, so outside it (scripts/dev sets
KOEINPUT_IN_DEV_CONTAINER) this script runs itself again through scripts/dev.
"""

import difflib
import fnmatch
import json
import os
import re
import subprocess
import sys
import textwrap
from dataclasses import dataclass, field as dataclass_field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLATFORM = "x86_64-unknown-linux-gnu"

HEADER = """\
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: koeinput
Upstream-Contact: Tatsuki Sugiura <sugi@nemui.org>
Source: https://github.com/sugi/koeinput
Comment: Generated by scripts/gen-copyright; do not edit by hand.

Files: *
Copyright: 2026 Tatsuki Sugiura
License: MIT or Apache-2.0
"""


@dataclass
class Paragraph:
    """A Files paragraph; `license` is an SPDX expression."""

    files: list
    copyright: list
    license: str
    comment: list = dataclass_field(default_factory=list)


