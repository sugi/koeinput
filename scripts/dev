#!/bin/sh
# Runs a command in a build container with the repository at /src.
# The outer dev container has no root and no -dev packages, so all builds go through here.
# KOEINPUT_DEV_IMAGE selects packaging/containers/dev-<name>.Containerfile (default trixie).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
name=${KOEINPUT_DEV_IMAGE:-trixie}
containerfile="$root/packaging/containers/dev-$name.Containerfile"
tag=$(sha256sum "$containerfile" | cut -c1-12)
image="localhost/koeinput-dev-$name:$tag"
if ! podman image exists "$image"; then
  nice -n 10 podman build -t "$image" -f "$containerfile" "$root/packaging/containers" >&2
fi
mkdir -p "$root/work/cache/cargo-registry" "$root/work/cache/cargo-git"
# Builds link the no-TTS sherpa-onnx libraries, which keep GPL code out of the binaries.
# The bookworm image has no Rust. scripts/sherpa-onnx sets KOEINPUT_DEV_NO_SHERPA when
# it runs its own tools here.
sherpa=
if [ "$name" != bookworm ] && [ -z "${KOEINPUT_DEV_NO_SHERPA:-}" ]; then
  lib=$("$root/scripts/sherpa-onnx")
  sherpa="SHERPA_ONNX_LIB_DIR=/src/${lib#"$root"/}"
fi
# Cargo never deletes old build variants; they pile up when features, dependencies
# or profiles change. A full set of dev, test and release builds is about 3.5 GB.
if [ "${1:-}" = cargo ] && [ -d "$root/target" ]; then
  limit=${KOEINPUT_TARGET_LIMIT_GB:-8}
  used=$(du -s --block-size=1G "$root/target" | cut -f1)
  if [ "$used" -gt "$limit" ]; then
    echo "scripts/dev: target/ uses $used GB (limit $limit GB); removing old Rust builds" >&2
    "$0" sh -c 'cargo clean --profile dev && cargo clean --release' >&2
  fi
fi
exec nice -n 10 podman run --rm -i --userns=keep-id \
  -v "$root:/src" -w /src \
  -v "$root/work/cache/cargo-registry:/usr/local/cargo/registry" \
  -v "$root/work/cache/cargo-git:/usr/local/cargo/git" \
  -e CARGO_TARGET_DIR=/src/target \
  -e KOEINPUT_MODEL_TESTS -e KOEINPUT_TEST_MODELS_DIR -e KOEINPUT_AUDIO_TESTS \
  -e KOEINPUT_TEST_DAEMON ${sherpa:+-e "$sherpa"} \
  "$image" "$@"
